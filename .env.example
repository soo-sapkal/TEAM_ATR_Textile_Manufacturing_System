# Loom Ledger - Local PostgreSQL Environment Configuration

# Database connection URL for local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loom_ledger

# Application Secrets
JWT_SECRET=super-secret-key-for-loom-ledger

# Optional: Cloudinary configuration for media uploads
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
